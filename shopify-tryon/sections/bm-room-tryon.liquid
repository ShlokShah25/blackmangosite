{%- comment -%}
  Black Mango — Room try-on.
  On a product page it shows a "View in your room" button that opens the try-on full screen,
  with that product already chosen. On any other page it shows the try-on inline.
  To put the button somewhere else on the product page (e.g. under Add to cart), add a
  "Custom Liquid" block there containing:
    <button type="button" class="button" data-bmto-trigger>View in your room</button>
{%- endcomment -%}
{{ 'bm-room-tryon.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bm-room-tryon.js' | asset_url }}" defer></script>

{%- liquid
  assign pool = section.settings.collection.products
  if section.settings.collection == blank
    assign pool = collections.all.products
  endif
  assign layout = 'inline'
  if template.name == 'product' and section.settings.product_button
    assign layout = 'modal'
  endif
  assign first_done = false
-%}

<style>
  #shopify-section-{{ section.id }} bm-room-tryon {
    --bmto-accent: {{ section.settings.accent }};
    --bmto-accent-ink: {{ section.settings.accent_text }};
  }
  {%- if layout == 'modal' %}
  #shopify-section-{{ section.id }} .bmto-trigger-wrap { padding-block: 12px; }
  {%- endif %}
</style>

<bm-room-tryon
  data-layout="{{ layout }}"
  {% if product %}data-product="{{ product.id }}"{% endif %}
  data-cart-label="{{ section.settings.cart_label | escape }}"
>
  <script type="application/json" data-products>
    [
      {%- if product -%}
        {%- render 'bm-tryon-item', p: product -%}
        {%- assign first_done = true -%}
      {%- endif -%}
      {%- for p in pool limit: 60 -%}
        {%- if product and p.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if first_done -%},{%- endif -%}
        {%- render 'bm-tryon-item', p: p -%}
        {%- assign first_done = true -%}
      {%- endfor -%}
    ]
  </script>

  {%- if layout == 'modal' -%}
    {%- if section.settings.show_section_button -%}
      <div class="bmto-wrap bmto-trigger-wrap">
        <button type="button" class="bmto-btn bmto-btn--solid bmto-open" data-bmto-open>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 10l9-7 9 7v10H3z"/><path d="M9 20v-6h6v6"/></svg>
          {{ section.settings.button_label | escape }}
        </button>
      </div>
    {%- endif -%}
    <dialog class="bmto-dialog" aria-label="{{ section.settings.heading | escape }}">
      <div class="bmto-wrap bmto-dialog-in">
        <div class="bmto-dialog-bar">
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
          <form method="dialog">
            <button class="bmto-close" aria-label="Close">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </form>
        </div>
        <div data-bmto-mount></div>
      </div>
    </dialog>
  {%- else -%}
    <div class="bmto-section">
      <div class="bmto-wrap">
        <div class="bmto-head">
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        </div>
        <div data-bmto-mount></div>
      </div>
    </div>
  {%- endif -%}
</bm-room-tryon>

{% schema %}
{
  "name": "Room try-on",
  "tag": "section",
  "class": "bmto-shopify-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it in your room" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Upload a photo of your space, tap where the piece goes, and see it there before you buy. Your photo stays on your device.</p>" },
    { "type": "collection", "id": "collection", "label": "Products to offer", "info": "Leave empty to offer every product." },
    { "type": "header", "content": "Product pages" },
    { "type": "checkbox", "id": "product_button", "label": "Open the try-on from a button", "default": true },
    { "type": "checkbox", "id": "show_section_button", "label": "Show the button in this section", "info": "Turn off if you placed the button elsewhere with a Custom Liquid block.", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View in your room" },
    { "type": "header", "content": "Style" },
    { "type": "text", "id": "cart_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "color", "id": "accent", "label": "Button colour", "default": "#111111" },
    { "type": "color", "id": "accent_text", "label": "Button text colour", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Room try-on" }],
  "enabled_on": { "templates": ["product", "page", "index", "collection"] }
}
{% endschema %}
